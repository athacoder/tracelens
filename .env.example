# TraceLens environment configuration. Copy to .env and fill in.
# Never commit .env.

# Storage. Defaults to local SQLite; use the postgres URL with docker compose.
DATABASE_URL=sqlite:///./tracelens.db
# DATABASE_URL=postgresql+psycopg://tracelens:tracelens@localhost:5432/tracelens

# SDK -> backend export target
TRACELENS_API_URL=http://localhost:8000
TRACELENS_API_KEY=

# Payload capture policy: full | redacted | metadata
TRACELENS_CAPTURE_MODE=redacted

# Optional LLM provider for the semantic forensic layer.
# Left empty, TraceLens uses the deterministic engine plus the mock provider.
TRACELENS_LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
